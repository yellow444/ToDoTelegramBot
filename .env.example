# --- Telegram ---
TOKEN=123456:replace-me
# Кто может пользоваться ботом (через запятую). Пусто — все.
ALLOWED_USER_IDS=
# Ваш chat id: по умолчанию сюда пишут MCP-инструменты (Claude Code / Codex)
OWNER_CHAT_ID=

# --- MongoDB (или MONGO_URI целиком) ---
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_USER=root
MONGO_PASS=change-me
DB_NAME=teleg
COLLECTION_NAME=collection

# --- Время и рабочий день (дефолты для новых пользователей, меняются в боте /work) ---
TZ=Europe/Moscow
WORK_START=09:00
WORK_END=18:00
WORKDAYS=1-5
# напоминание по умолчанию, если время не указано (0 — без напоминания)
DEFAULT_REMIND_HOURS=24
NAG_MINUTES=10
MAX_NAGS=6

# --- Mini App: публичный https-адрес (со слешем на конце) ---
WEBAPP_URL=
WEB_PORT=8080
# держать HTTP-соединение, с (больше паузы опроса воркера)
WEB_KEEP_ALIVE=75
# писать в лог замирания бота дольше стольких секунд (0 - не писать)
STALL_WARN_SECONDS=1.0

# --- LLM: любой OpenAI-совместимый endpoint ---
# локально: http://localhost:8091/v1, в docker-сети llm-gateway: http://llmgw-gateway:8080/v1
LLM_BASE_URL=
LLM_MODEL=general35
LLM_API_KEY=not-needed
# 300 с — запас на холодную загрузку модели в llama-swap
LLM_TIMEOUT=300
# запасная модель, если основная недоступна (бесплатная облачная через шлюз)
LLM_FALLBACK_MODEL=free

# --- MCP по HTTP (/mcp). Без токена /mcp доступен только с localhost ---
MCP_TOKEN=
# пускать /mcp без токена с этой машины (loopback и шлюз docker-сети); другим нужен MCP_TOKEN
MCP_TRUST_HOST=true

# Для certbot в docker-compose
DOMAIN_NAME=
CERTBOT_EMAIL=

# --- Агенты-коворкеры: Claude Code / Codex по подписке (без API-ключей) ---
# алиас=путь через «;»
AGENT_WORKDIRS=todo=C:\repos\ToDoTelegramBot;gw=C:\repos\llm-gateway
# папка для заданий без проекта
AGENT_HOME=C:\Users\me\agent-home
# адрес бота для воркера (python -m todobot.worker), авторизация — MCP_TOKEN
WORKER_API=http://localhost:8088
WORKER_AGENTS=claude,codex
AGENT_TIMEOUT=3600
# невзятый разбор дня старше стольких часов отменяется (приложение было закрыто)
ORCHESTRATION_TTL_HOURS=12
CLAUDE_PERMISSION_MODE=acceptEdits
CLAUDE_ALLOWED_TOOLS=
CODEX_SANDBOX=workspace-write

# --- Распознавание голоса, видео и картинок ---
# telegram — Telegram Premium через userbot (нужны TG_API_*), local — whisper в контейнере, openai — внешний STT, off
STT_PROVIDER=telegram
STT_FALLBACK=local
STT_MODEL=large-v3-turbo
STT_LANGUAGE=ru
STT_DEVICE=cpu
# для STT_PROVIDER=openai: OpenAI-совместимый /audio/transcriptions
STT_BASE_URL=
# общий словарь подсказок через запятую (свой словарь у каждого — команда /vocab)
STT_PROMPT=
STT_LLM_FIX=true
# vision-модель шлюза для текста с картинок (пусто — не распознавать)
OCR_MODEL=vision

# --- Userbot для расшифровки Telegram Premium: https://my.telegram.org -> API development tools ---
TG_API_ID=
TG_API_HASH=
TG_SESSION=data/userbot.session

# --- Вложения для агентов ---
FILES_DIR=data/files
# тот же каталог, как его видит хост (для путей, которые получают агенты на ПК)
FILES_HOST_DIR=C:\repos\ToDoTelegramBot\data\files
AGENT_CONTEXT_DIR=agent-context

# --- Прочее ---
# memory — без Mongo (для отладки); RUN_BOT=false — только веб и MCP
STORAGE=mongo
RUN_BOT=true
MCP_HTTP_ENABLED=true
