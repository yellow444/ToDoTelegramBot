server {
    listen 443 default_server ssl;
    http2  on;

    server_name ${DOMAIN_NAME} www.${DOMAIN_NAME} localhost;

    ssl_certificate /etc/nginx/ssl/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/live/${DOMAIN_NAME}/privkey.pem;
    
    # Telegram Mini App бота: WEBAPP_URL=https://<домен>/app/
    location /app/ {
        proxy_pass http://todobot:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # MCP наружу публикуйте, только если нужен доступ не с этой машины (требует MCP_TOKEN):
    # location /mcp {
    #     proxy_pass http://todobot:8080/mcp;
    #     proxy_http_version 1.1;
    #     proxy_buffering off;
    #     proxy_set_header Host $host;
    # }

    location / {
        root /etc/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
