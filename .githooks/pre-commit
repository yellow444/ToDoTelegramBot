#!/bin/sh
# Не даёт закоммитить .env и токены Telegram-ботов.
# Включение (один раз): git config core.hooksPath .githooks
fail=0
if git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env$' >/dev/null; then
  echo "pre-commit: .env не коммитим (секреты). Уберите: git rm --cached .env" >&2
  fail=1
fi
if git diff --cached -U0 --diff-filter=ACMR | grep -E '^\+' | grep -E '[0-9]{8,10}:AA[A-Za-z0-9_-]{30,}' >/dev/null; then
  echo "pre-commit: в изменениях похоже на токен Telegram-бота" >&2
  fail=1
fi
exit $fail
